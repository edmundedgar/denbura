{
  "speed": [
    { "if": "road_class == TRUNK",                                                                    "limit_to": "50" },
    { "if": "road_class == PRIMARY",                                                                  "limit_to": "40" },
    { "if": "road_class != MOTORWAY && road_class != TRUNK && road_class != PRIMARY", "limit_to": "30" }
  ],
  "priority": [
    { "if": "road_class == MOTORWAY", "multiply_by": "0.1" }
  ]
}
